      "css": ".ds-ghost{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;line-height:1.4;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:46px;padding:12px 20px;border:0;border-radius:8px;font-weight:600;background:none;color:var(--muted,#58665b);padding-inline:12px;}.ds-ghost:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}.ds-ghost:hover:not(:disabled){filter:brightness(.96)}:host-context([data-theme=dark]) .ds-ghost:hover:not(:disabled){filter:brightness(1.13)}.ds-ghost:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Search input",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Labelled dictionary search with an inset inline icon.",
      "html": "<label class=\"ds-search\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m16 16 5 5\"/></svg><input class=\"ds-search-input\" type=\"search\" aria-label=\"Поиск по словарю\" placeholder=\"Найти слово или перевод…\"></label>",
      "css": ".ds-search{display:block;position:relative}.ds-search svg{position:absolute;left:14px;top:14px;width:20px;height:20px;fill:none;stroke:var(--muted,#58665b);stroke-width:1.7}.ds-search-input{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;min-height:48px;width:100%;border:1px solid var(--line,#ccd5c9);border-radius:8px;padding:12px 14px 12px 44px;background:var(--surface,#fff);color:var(--ink,#243329)}.ds-search-input::placeholder{color:var(--muted,#58665b);opacity:1}.ds-search-input:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Rail navigation with a distinct current location.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Основная навигация\"><button class=\"ds-nav-item\" aria-current=\"page\">Карточки</button><button class=\"ds-nav-item\">Словарь</button></nav>",
      "css": ".ds-nav{background:var(--rail,#4e6851);color:var(--rail-text,#fff);padding:20px;display:flex;flex-direction:column;gap:6px}.ds-nav-item{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;line-height:1.4;cursor:pointer;text-align:left;border:0;color:inherit;background:none;padding:10px 14px;min-height:46px;border-radius:8px;font-weight:550}.ds-nav-item[aria-current]{background:var(--active,#fff);color:var(--active-ink,#304c35)}.ds-nav-item:not([aria-current]):hover{background:#ffffff14}.ds-nav-item:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}.ds-nav-item:hover:not(:disabled){filter:brightness(.96)}:host-context([data-theme=dark]) .ds-nav-item:hover:not(:disabled){filter:brightness(1.13)}.ds-nav-item:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Filter chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Unit filter with an explicit pressed state.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">Unit 03</button>",
      "css": ".ds-chip{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;line-height:1.4;cursor:pointer;min-height:44px;padding:10px 17px;border:1px solid var(--line,#ccd5c9);border-radius:8px;background:var(--surface,#fff);color:var(--ink,#243329);font-size:14px}.ds-chip[aria-pressed=true]{background:var(--accent,#4e6851);border-color:var(--accent,#4e6851);color:#fff}.ds-chip:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}.ds-chip:hover:not(:disabled){filter:brightness(.96)}:host-context([data-theme=dark]) .ds-chip:hover:not(:disabled){filter:brightness(1.13)}.ds-chip:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Study card",
      "kind": "card",
      "refersTo": "flash-card",
      "description": "Source annotation and prominent study word; the revealed state uses soft.",
      "html": "<article class=\"ds-card\"><span class=\"ds-card-meta\">Unit 03 · Источник текста</span><h2>academic</h2><button class=\"ds-card-reveal\">Показать перевод</button></article>",
      "css": ".ds-card{font-family:\"Segoe UI\",Arial,sans-serif;position:relative;display:flex;flex-direction:column;align-items:center;min-height:310px;padding:24px 30px;border:1px solid var(--line,#ccd5c9);border-radius:var(--radius,12px);background:var(--surface,#fff);color:var(--ink,#243329);text-align:center}.ds-card-meta{align-self:start;font-size:11px;line-height:1.65;color:var(--muted,#58665b)}.ds-card h2{font-size:clamp(27px,3.6vw,42px);font-weight:650;line-height:1.25;letter-spacing:-.025em;margin:26px 0 14px;overflow-wrap:anywhere}.ds-card-reveal{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;line-height:1.4;cursor:pointer;border:0;background:none;color:var(--muted,#58665b);min-height:44px;margin-top:auto;font-size:12px;padding:20px 0 0}.ds-card.is-revealed{background:var(--soft,#e8eee5)}.ds-card-reveal:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}.ds-card-reveal:hover:not(:disabled){filter:brightness(.96)}:host-context([data-theme=dark]) .ds-card-reveal:hover:not(:disabled){filter:brightness(1.13)}.ds-card-reveal:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Source-linked word",
      "kind": "custom",
      "refersTo": "source-reference",
      "description": "Expandable dictionary term with wrapping provenance immediately underneath.",
      "html": "<button class=\"ds-source-word\" aria-expanded=\"false\"><span class=\"ds-source-term\">academic</span><span class=\"ds-source-meta\">Unit 03 · Название текста · стр. 42–45</span></button>",
      "css": ".ds-source-word{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;line-height:1.4;cursor:pointer;text-align:left;min-height:44px;padding:0;border:0;background:none;color:var(--ink,#243329)}.ds-source-term{display:block;font-size:17px;font-weight:600;overflow-wrap:anywhere}.ds-source-meta{display:block;font-size:11px;line-height:1.65;color:var(--muted,#58665b);margin-top:6px}.ds-source-word:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}.ds-source-word:hover:not(:disabled){filter:brightness(.96)}:host-context([data-theme=dark]) .ds-source-word:hover:not(:disabled){filter:brightness(1.13)}.ds-source-word:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Answer choice",
      "kind": "button",
      "refersTo": "answer-option",
      "description": "Choice with keyed label and correct/wrong feedback variants.",
      "html": "<button class=\"ds-option\"><span class=\"ds-option-key\">1</span>академический</button>",
      "css": ".ds-option{font-family:\"Segoe UI\",Arial,sans-serif;font-size:15px;line-height:1.4;cursor:pointer;display:flex;gap:14px;align-items:center;text-align:left;padding:15px;min-height:68px;border:1px solid var(--line,#ccd5c9);border-radius:10px;background:var(--surface,#fff);color:var(--ink,#243329)}.ds-option-key{display:flex;align-items:center;justify-content:center;min-width:28px;height:28px;font-size:12px;color:var(--muted,#58665b);background:var(--soft,#e8eee5);border-radius:6px}.ds-option.correct{border-color:var(--success,#315c3a);background:var(--soft,#e8eee5);color:var(--success,#315c3a)}.ds-option.wrong{border-color:var(--error,#9c3b34);background:var(--error-bg,#fcf0ee);color:var(--error,#9c3b34)}.ds-option:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}.ds-option:hover:not(:disabled){filter:brightness(.96)}:host-context([data-theme=dark]) .ds-option:hover:not(:disabled){filter:brightness(1.13)}.ds-option:disabled{opacity:.5;cursor:not-allowed}.ds-option:disabled{opacity:1}"
    },
    {
      "name": "Settings dialog",
      "kind": "custom",
      "description": "Native modal settings surface; call showModal() for its implemented backdrop.",
      "html": "<dialog open class=\"ds-dialog\" aria-labelledby=\"ds-dialog-title\"><header class=\"ds-dialog-header\"><h2 id=\"ds-dialog-title\">Твоё пространство</h2><button class=\"ds-dialog-close\" aria-label=\"Закрыть настройки\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button></header><p class=\"ds-dialog-copy\">Прогресс сохраняется в этом браузере.</p></dialog>",
      "css": ".ds-dialog{position:relative;font-family:\"Segoe UI\",Arial,sans-serif;width:min(560px,calc(100% - 28px));max-height:85vh;border:0;border-radius:16px;padding:28px;background:var(--surface,#fff);color:var(--ink,#243329);box-shadow:var(--shadow,0 18px 60px #16291b26)}.ds-dialog::backdrop{background:#101d17a6}.ds-dialog-header{display:flex;justify-content:space-between;align-items:center;gap:14px}.ds-dialog-header h2{font-size:24px;font-weight:650;line-height:1.3;letter-spacing:-.02em;margin:0}.ds-dialog-copy{font-size:13px;color:var(--muted,#58665b);line-height:1.65;margin:10px 0 16px}.ds-dialog-close{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:0;border-radius:8px;color:var(--ink,#243329);cursor:pointer}.ds-dialog-close svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}.ds-dialog-close:hover{background:var(--soft,#e8eee5);filter:brightness(.96)}.ds-dialog-close:focus-visible{outline:3px solid var(--focus,#58723d);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Reading annotations",
    "overview": "A calm, practical study workspace connects vocabulary to its source reading. A sage navigation rail, paper surfaces and clear system type give familiar controls a coherent academic character. The user delegated composition while fixing the principal green and retaining light/dark themes and Russian/Kazakh support.\n\nDensity follows the task: compact dictionary rows and source notes surround a generous central study word. Tonal separation and fine borders carry hierarchy; decoration does not compete with reading.",
    "keyCharacteristics": [
      "Familiar controls with a clear primary action.",
      "Paper-like light surfaces and charcoal-green dark surfaces.",
      "Source references stay adjacent to the vocabulary they explain."
    ],
    "rules": [],
    "dos": [
      "Do use semantic CSS variables so both themes retain the same hierarchy.",
      "Do keep unit, reading title and page references with vocabulary; permit wrapping.",
      "Do retain visible focus, labelled controls and keyboard access in Russian and Kazakh.",
      "Do let long translations and source titles wrap at narrow widths."
    ],
    "donts": [
      "Don't introduce a separate display font or decorative imagery into study controls.",
      "Don't communicate correctness with color alone; retain feedback text and icons.",
      "Don't present reading page ranges as verified page locations for every word.",
      "Don't animate when reduced motion is requested."
    ]
  }
}
